# LLM provider. Keep mock for the current POC.
LLM_PROVIDER=mock

# Leave DATABASE_URL empty for browser-local Demo mode.
# Set it to a Neon/PostgreSQL connection string to enable production persistence.
DATABASE_URL=

# Required only for the one-time first teacher bootstrap.
# Use a long random value; remove/rotate it after bootstrap.
ADMIN_SETUP_KEY=

# Future real LLM:
# OPENAI_API_KEY=
