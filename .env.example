APP_ENV=development
LLM_PROVIDER=mock

# Leave empty for browser-local Demo mode.
DATABASE_URL=

# Required only while creating/promoting the first administrator.
# In production use at least 32 random bytes, then rotate/remove after setup.
ADMIN_SETUP_KEY=

# Opaque DB-backed session settings.
AUTH_SESSION_TTL_SECONDS=43200

# Optional. If empty, same-origin is derived from the incoming Host/forwarded headers.
# Comma-separated, e.g. https://example.vercel.app,http://localhost:3000
AUTH_ALLOWED_ORIGINS=

AUTH_THROTTLE_FAILURE_LIMIT=5
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_THROTTLE_BLOCK_SECONDS=900

# Future real LLM:
# OPENAI_API_KEY=
