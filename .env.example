APP_ENV=development
LLM_PROVIDER=mock

# Database selection:
# - local Windows/Linux default: sqlite
# - set DB_DRIVER=browser for the old localStorage-only demo
# - future PostgreSQL: DB_DRIVER=postgres + DATABASE_URL
DB_DRIVER=sqlite
SQLITE_PATH=./data/aisp.sqlite

# Future PostgreSQL / Neon upgrade path:
DATABASE_URL=

# Required while creating/promoting the first administrator.
# In production use at least 32 random bytes, then rotate/remove after setup.
# Local npm run dev generates a temporary setup key if this is empty.
ADMIN_SETUP_KEY=

AUTH_SESSION_TTL_SECONDS=43200

# Optional explicit same-origin allowlist.
# AUTH_ALLOWED_ORIGINS=https://example.internal,http://localhost:3000
AUTH_ALLOWED_ORIGINS=

AUTH_THROTTLE_FAILURE_LIMIT=5
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_THROTTLE_BLOCK_SECONDS=900

# Future real LLM:
# OPENAI_API_KEY=
