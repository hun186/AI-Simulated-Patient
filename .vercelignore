# Vercel is an isolated browser-local PoC surface. Allow only static UI, demo helpers/prompts, and the single demo API (Mock + optional visitor-owned Groq BYOK).
/*
!/.vercelignore
!/vercel.json
!/package.json
!/index.html
!/styles.css
!/formal.css
!/formal-app.js
!/report-export.js
!/support-bundle.js
!/api
/api/*
!/api/demo.js
!/lib
/lib/*
!/lib/cases.js
!/lib/mock-patient.js
!/lib/mock-coach.js
!/lib/mock-evaluator.js
!/lib/assessment-utils.js
!/lib/llm
/lib/llm/*
!/lib/llm/prompts.js
