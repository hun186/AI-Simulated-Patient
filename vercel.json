{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "outputDirectory": null,
  "devCommand": null,
  "installCommand": "",
  "rewrites": [
    {
      "source": "/api/runtime",
      "destination": "/api/demo?route=runtime"
    },
    {
      "source": "/api/health",
      "destination": "/api/demo?route=health"
    },
    {
      "source": "/api/cases",
      "destination": "/api/demo?route=cases"
    },
    {
      "source": "/api/chat",
      "destination": "/api/demo?route=chat"
    },
    {
      "source": "/api/coach",
      "destination": "/api/demo?route=coach"
    },
    {
      "source": "/api/evaluate",
      "destination": "/api/demo?route=evaluate"
    },
    {
      "source": "/api/teacher/cases",
      "destination": "/api/demo?route=teacher-cases"
    }
  ]
}
